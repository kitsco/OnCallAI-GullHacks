# Copy this file to .env  (cp .env.example .env)  and edit it. Never commit .env.

# Which payments-api version runs: v1 (good) or v2 (rounding bug). The bad-deploy fault flips this.
IMAGE_TAG=v1

# Postgres password. Pick anything; it never leaves the server.
POSTGRES_PASSWORD=change-me-please

AWS_REGION=us-east-2

# ---- SERVER ONLY: uncomment these two lines on the EC2 server ----
#COMPOSE_FILE=docker-compose.yml:docker-compose.aws.yml
#METRICS_ENABLED=1
